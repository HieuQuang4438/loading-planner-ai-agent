# Google AI Studio API key cho Gemini; nhiều key thì GOOGLE_API_KEY_1, GOOGLE_API_KEY_2... (dùng lần lượt)
GOOGLE_API_KEY=your-key-here
# Model đọc tài liệu; bỏ trống thì dùng mặc định trong src/llm/client.py (DEFAULT_MODEL)
GEMINI_MODEL=
# Mức thinking: minimal, low, medium, high hoặc default
GEMINI_THINKING=
# Model của chat; bỏ trống thì dùng GEMINI_MODEL
GEMINI_CHAT_MODEL=
